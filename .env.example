# ---------------------------------------------------------------------------
# Azure Cosmos DB
# ---------------------------------------------------------------------------
# Local development uses the Azure Cosmos DB vNext emulator (Docker):
#   npm run cosmos:up
# The endpoint is plain HTTP on localhost and the key is the public emulator key.
COSMOS_ENDPOINT=http://localhost:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DATABASE=app
COSMOS_CONTAINER=items
COSMOS_PARTITION_VALUE=users

# Production: replace the Cosmos settings above with an Azure Cosmos DB account.
# The key is the account's primary key:
#   az cosmosdb keys list -n <account> -g <resource-group> --query primaryMasterKey -o tsv
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_KEY=<primary-key>

# "cosmos" persists to Cosmos DB (emulator or Azure).
# "memory" runs a seeded, ephemeral in-process store for UI work with no database.
# `npm run dev` always uses memory and `npm run dev:cosmos` always uses cosmos;
# this value applies to `npm start` and `npm run dev:server`.
DATA_STORE=cosmos

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=8080
CLIENT_ORIGIN=http://localhost:3000
